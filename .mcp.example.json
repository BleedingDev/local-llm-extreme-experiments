{
  "mcpServers": {
    "trace-rag": {
      "command": "/absolute/path/to/this/repo/.venv-gepa/bin/python",
      "args": [
        "-m",
        "mcp_servers.trace_rag.server"
      ],
      "env": {
        "PYTHONPATH": "/absolute/path/to/this/repo/trace-gepa",
        "TRACE_RAG_INDEX_DIR": "/absolute/path/to/this/repo/trace-gepa/artifacts/rag_index_v2"
      }
    }
  }
}
