.venv/
.venv-gepa/
__pycache__/
*.py[cod]

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.coverage
htmlcov/

# Notebook/editor/OS noise
.ipynb_checkpoints/
.DS_Store
.cursor/*.out
.oracle_probe.txt

# Local runtime outputs and caches
.cache/
outputs/
artifacts/
logs/
tmp/
*.log
vendor/
bench/vendor/
bench/.venv/
bench/jobs/
bench/aider_polyglot/results/
bench/ablation/results/
bench/bag-runtime/node_modules/

# trace-gepa: raw traces, derived RAG indexes, run intermediates
trace-gepa/data/*.jsonl
trace-gepa/data/sanitised/
trace-gepa/data/codex_session_models.json
trace-gepa/artifacts/optimized-prompts/*/gepa_state/
trace-gepa/artifacts/rag_index*
trace-gepa/artifacts/anomaly_*.pkl
trace-gepa/artifacts/real_smoke/
trace-gepa/artifacts/lora_adapters/
trace-gepa/.pytest_cache/
trace-gepa/.venv-gepa/

# Whitelist trace-gepa artefacts we explicitly want tracked
# (top-level `artifacts/` rule above otherwise blocks them)
!trace-gepa/artifacts/
!trace-gepa/artifacts/CLAUDE.generated.md
!trace-gepa/artifacts/optimized-prompts/
!trace-gepa/artifacts/optimized-prompts/**
trace-gepa/artifacts/optimized-prompts/*/gepa_state/

# Local agent orchestration state
.codex/plan-graphs/
.claude/worktrees/
.claude/scheduled_tasks.lock
docs/plans/

# BleedingAgent TypeScript workspace
node_modules/
dist/
.bag/

# Secrets / local-only config
.env
.env.*
!.env.example
bag.config.json
.mcp.json
